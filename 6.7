/// 1. Custom StatelessWidget (from the notes) with parameters.
///    If no color is given, it falls back to the theme's primary color.
class CustomButton extends StatelessWidget {
  final String label;
  final VoidCallback onPressed;
  final Color? color;
  final IconData? icon;

  const CustomButton({
    super.key,
    required this.label,
    required this.onPressed,
    this.color,
    this.icon,
  });

  @override
  Widget build(BuildContext context) {
    final bg = color ?? Theme.of(context).colorScheme.primary;
    final fg = ThemeData.estimateBrightnessForColor(bg) == Brightness.dark
        ? Colors.white
        : Colors.black;

    return ElevatedButton.icon(
      style: ElevatedButton.styleFrom(backgroundColor: bg, foregroundColor: fg),
      onPressed: onPressed,
      icon: icon != null ? Icon(icon) : const SizedBox.shrink(),
      label: Text(label),
    );
  }
}

/// 2. Custom widget composed of other widgets and styled from the theme.
class ProfileCard extends StatelessWidget {
  final String name;
  final String role;
  final VoidCallback? onTap;

  const ProfileCard({super.key, required this.name, required this.role, this.onTap});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);

    return Card(
      child: ListTile(
        onTap: onTap,
        leading: CircleAvatar(
          backgroundColor: theme.colorScheme.secondaryContainer,
          child: Text(name[0], style: theme.textTheme.titleMedium),
        ),
        title: Text(name, style: theme.textTheme.titleMedium),
        subtitle: Text(role, style: theme.textTheme.bodyMedium),
        trailing: const Icon(Icons.chevron_right),
      ),
    );
  }
}

/// 3. Custom widget that reads a ThemeExtension.
enum StatusType { success, warning }

class StatusBadge extends StatelessWidget {
  final String text;
  final StatusType type;

  const StatusBadge({super.key, required this.text, required this.type});

  @override
  Widget build(BuildContext context) {
    final brand = Theme.of(context).extension<BrandColors>()!;
    final color = type == StatusType.success ? brand.success : brand.warning;

    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
      decoration: BoxDecoration(
        color: color.withOpacity(0.15),
        border: Border.all(color: color),
        borderRadius: BorderRadius.circular(20),
      ),
      child: Text(text, style: TextStyle(color: color, fontWeight: FontWeight.w600)),
    );
  }
}

/// 4. Custom StatefulWidget: interactive and keeps its own state.
class LikeButton extends StatefulWidget {
  final int initialCount;
  final ValueChanged<bool>? onChanged;

  const LikeButton({super.key, this.initialCount = 0, this.onChanged});

  @override
  State<LikeButton> createState() => _LikeButtonState();
}

class _LikeButtonState extends State<LikeButton> {
  late int _count = widget.initialCount;
  bool _liked = false;

  void _toggle() {
    setState(() {
      _liked = !_liked;
      _count += _liked ? 1 : -1;
    });
    widget.onChanged?.call(_liked);
  }

  @override
  Widget build(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;

    return TextButton.icon(
      onPressed: _toggle,
      icon: AnimatedSwitcher(
        duration: const Duration(milliseconds: 200),
        child: Icon(
          _liked ? Icons.favorite : Icons.favorite_border,
          key: ValueKey(_liked),
          color: _liked ? scheme.error : scheme.onSurfaceVariant,
        ),
      ),
      label: Text('$_count'),
    );
  }
}

/// 5. Reusable labeled text field; decoration comes from InputDecorationTheme.
class LabeledField extends StatelessWidget {
  final String label;
  final TextEditingController? controller;
  final bool obscure;

  const LabeledField({
    super.key,
    required this.label,
    this.controller,
    this.obscure = false,
  });

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 8),
      child: TextField(
        controller: controller,
        obscureText: obscure,
        decoration: InputDecoration(labelText: label),
      ),
    );
  }
}

