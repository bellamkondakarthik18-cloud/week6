  const DemoPage({super.key, required this.onThemeToggle});

  @override
  Widget build(BuildContext context) {
    final theme = Theme.of(context);
    final isDark = theme.brightness == Brightness.dark;

    return Scaffold(
      appBar: AppBar(
        title: const Text('Custom Widgets & Theming'),
        actions: [
          Switch(value: isDark, onChanged: onThemeToggle),
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          Text('Buttons', style: theme.textTheme.headlineSmall),
          const SizedBox(height: 8),
          Wrap(
            spacing: 12,
            runSpacing: 12,
            children: [
              // Uses theme primary color
              CustomButton(label: 'Default', onPressed: () {}),
              // Overrides color + adds icon
              CustomButton(
                label: 'Delete',
                icon: Icons.delete,
                color: Colors.red,
                onPressed: () {},
              ),
            ],
          ),
          const SizedBox(height: 24),

          Text('Cards', style: theme.textTheme.headlineSmall),
          ProfileCard(name: 'Asha Rao', role: 'Flutter Developer', onTap: () {}),
          ProfileCard(name: 'Vikram Singh', role: 'UI Designer', onTap: () {}),
          const SizedBox(height: 24),

          Text('Theme Extension', style: theme.textTheme.headlineSmall),
          const SizedBox(height: 8),
          const Row(
            children: [
              StatusBadge(text: 'Paid', type: StatusType.success),
              SizedBox(width: 12),
              StatusBadge(text: 'Pending', type: StatusType.warning),
            ],
          ),
          const SizedBox(height: 24),

          Text('Stateful custom widget', style: theme.textTheme.headlineSmall),
          const LikeButton(initialCount: 12),
          const SizedBox(height: 24),

          Text('Form fields', style: theme.textTheme.headlineSmall),
          const LabeledField(label: 'Email'),
          const LabeledField(label: 'Password', obscure: true),
          const SizedBox(height: 24),

          Text('Local theme override', style: theme.textTheme.headlineSmall),
          const SizedBox(height: 8),
          // Theme(...) overrides the theme for just this subtree
          Theme(
            data: theme.copyWith(
              colorScheme: ColorScheme.fromSeed(
                seedColor: Colors.teal,
                brightness: theme.brightness,
              ),
            ),
            child: Builder(
              builder: (ctx) => CustomButton(label: 'Teal subtree', onPressed: () {}),
            ),
          ),
        ],
      ),
    );
  }
}
