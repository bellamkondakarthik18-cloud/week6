import 'package:flutter/material.dart';

class UserCard extends StatelessWidget {
  final String name;
  final String role;
  final Color color;

  const UserCard({
    super.key,
    required this.name,
    required this.role,
    this.color = Colors.blue,
  });

  @override
  Widget build(BuildContext context) {
    return Card(
      child: ListTile(
        leading: CircleAvatar(
          backgroundColor: color,
          child: const Icon(
            Icons.person,
            color: Colors.white,
          ),
        ),
        title: Text(name),
        subtitle: Text(role),
      ),
    );
  }
}
